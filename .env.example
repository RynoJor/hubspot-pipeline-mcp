# Copy to .env and fill in. .env is git-ignored. Never commit a real token.

# fixtures (default): serve the bundled synthetic snapshot, no account needed.
# live: read from HubSpot with the token below.
HUBSPOT_MODE=fixtures

# Private-app token from a HubSpot developer TEST account.
# Read-only scopes: crm.objects.contacts.read, crm.objects.deals.read, crm.objects.owners.read
HUBSPOT_TOKEN=

# Optional. "seeded" reads the custom properties written by scripts/seed_hubspot.py
# (rep name, last activity date) and pins "today" to the snapshot date, 2026-10-31.
# HUBSPOT_PROFILE=seeded

# Optional. Pin "today" for idle-day maths (YYYY-MM-DD). Default: today (UTC).
# HUBSPOT_AS_OF=

# Optional. Seconds to cache a live read of the portal. Default 300.
# HUBSPOT_CACHE_SECONDS=300

# Only for scripts/seed_hubspot.py. A SEPARATE token with write scopes, test account only.
# HUBSPOT_SEED_TOKEN=
